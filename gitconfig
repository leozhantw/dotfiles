[user]
	name = LeoZhan
	email = leo3838ok@gmail.com
[core]
	excludesfile = ~/.gitignore
	quotepath = false
[color]
	ui = auto
[alias]
	fp = fetch -p
	#############
	br = branch
	brr = branch -r
	#############
	ci = commit
	cim = commit -m
	#############
	co = checkout
	cotb = checkout --track -b
	#############
	st = status
	#############
	df = diff
	#############
	cp = cherry-pick
	#############
	pl = pull
	plr = pull --rebase
	plo = pull origin
	plro = pull --rebase origin
	#############
	ps = push
	pso = push -u origin
	psf = push --force-with-lease
	#############
	rb = rebase
	rbi = rebase -i
	#############
	re = reset
	reh = reset --hard
	rehh = reset --hard HEAD
[gui]
	encoding = utf-8
[i18n "commit"]
	encoding = utf-8
[i18n]
	logoutputencoding = utf-8
[pull]
	rebase = true
[pager]
	branch = false
[init]
	defaultBranch = main
[credential "https://github.com"]
	helper = 
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !gh auth git-credential
